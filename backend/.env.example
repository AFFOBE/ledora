NODE_ENV=production
PORT=5000
TZ=Asia/Kolkata
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/ledora
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
# Public frontend URL. Used for public lead links and CORS.
CLIENT_URL=https://ledora.app
# Kept for legacy callers; set to the same public frontend URL in production.
BASE_URL=https://ledora.app

# Public URL used for uploaded social media (Instagram/Facebook fetch it).
# Falls back to BASE_URL when empty. Must be publicly reachable in production.
MEDIA_BASE_URL=

# AI content + creative generation
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_IMAGE_ENABLED=true
FAL_KEY=
FAL_VIDEO_MODEL=fal-ai/ltx-video

# Public mirror for generated media: catbox | none
MEDIA_PUBLIC_DRIVER=catbox

# Auto-publishing queue
SOCIAL_SCHEDULER_INTERVAL_MS=60000
SOCIAL_PUBLISH_TIMEOUT_MS=1200000

# Yearly plans get a fresh 30-day batch every ~30 days.
SOCIAL_MONTHLY_REFRESH_MS=2592000000
SOCIAL_REFRESH_CHECK_MS=21600000

# LinkedIn Marketing API version header (YYYYMM). Empty = current month.
# Override when LinkedIn announces the sunset of the current version.
LINKEDIN_API_VERSION=
