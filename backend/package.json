{
  "name": "backend",
  "version": "1.0.0",
  "description": "Ledora API - Node.js + Express + MongoDB",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node seed/seed.js",
    "db:start": "powershell -NoProfile -Command \"if (!(Test-Path '.data\\db')) { New-Item -ItemType Directory -Force -Path '.data\\db' | Out-Null }; Start-Process -FilePath 'C:\\Program Files\\MongoDB\\Server\\8.2\\bin\\mongod.exe' -ArgumentList '--dbpath','.data\\db','--port','27017' -WindowStyle Hidden -RedirectStandardOutput '.data\\mongod.log' -RedirectStandardError '.data\\mongod.err.log'\"",
    "db:stop": "taskkill /F /IM mongod.exe"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-wasm": "^4.22.0",
    "@vladmandic/face-api": "^1.7.15",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^4.22.3",
    "express-mongo-sanitize": "^2.2.0",
    "express-validator": "^7.3.2",
    "ffmpeg-static": "^5.3.0",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.1",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "node-edge-tts": "^1.2.12",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
